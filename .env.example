# Required
FIRECRAWL_API_KEY=fc-your-key
GOOGLE_SHEET_ID=1Ohi2amTCPnIZZont7rwOLO487DFk64-pemLT8O76xq4
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json

# Optional: Jina Reader works without a key at a lower rate limit.
JINA_API_KEY=

# Free-tier-safe collector behavior
TIMEZONE=Asia/Shanghai
MAX_CONCURRENCY=2
MAX_URLS_PER_RUN=32
MIN_BODY_CHARS=1200
EDITOR_MIN_BODY_CHARS=2500
CONTENT_CELL_LIMIT=45000
CACHE_HOURS=168
FIRECRAWL_TBS=
FIRECRAWL_FALLBACK_DAILY_LIMIT=3
COLLECTOR_TOKEN=replace-with-a-random-secret
